# Neon connection string. Vercel can read this from the project environment.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Used to encrypt coach API keys with AES-256-GCM before they are written to Postgres.
# Use a long random value in production.
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional: identify the local/demo player when no auth provider is wired in.
DEMO_GITHUB_USERNAME=demo-player
